{
  "name": "candle",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A lot is on the table, the candle is burning, and every inch you wait is worth less.",
  "scripts": {
    "dev": "vite --port 3200 --strictPort",
    "build": "node scripts/require-sdk.mjs && vite build",
    "preview": "vite preview --port 3200 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "verify:rtp": "vite-node scripts/verify-rtp.ts",
    "gen:constants": "vite-node scripts/gen-constants.ts",
    "serve:headers": "node scripts/serve-with-headers.mjs",
    "gates": "node scripts/gates.mjs",
    "gates:headers": "node scripts/gates.mjs --headers-only",
    "spike": "vite-node scripts/spike-sdk.ts",
    "sdk:stack": "npm --prefix sdk/casino-sdk start",
    "sdk:fetch": "node scripts/fetch-sdk.mjs",
    "sdk:install": "npm --prefix sdk/casino-sdk install",
    "round-trip": "vite-node scripts/round-trip.ts",
    "round-trip:brokers": "vite-node scripts/round-trip-brokers.ts",
    "round-trip:survey": "vite-node scripts/round-trip-survey.ts",
    "bench": "vite-node scripts/bench.ts",
    "sync:simulator": "node scripts/sync-simulator.mjs",
    "play": "vite-node scripts/play-demo.ts",
    "play:brokers": "vite-node scripts/play-brokers.ts",
    "play:survey": "vite-node scripts/play-survey.ts",
    "verify:light": "vite-node scripts/verify-light.ts",
    "cold-open": "vite-node scripts/cold-open.ts",
    "frame-budget": "vite-node scripts/frame-budget.ts",
    "bundle:single": "node scripts/bundle-single.mjs",
    "gen:readme": "vite-node scripts/gen-readme.ts",
    "gen:demo": "vite-node scripts/gen-demo.ts",
    "gates:iframe": "node scripts/iframe-check.mjs",
    "deploy": "vercel deploy --prod",
    "verify:live": "node scripts/gates.mjs --headers-only --origin",
    "ship": "node scripts/ship.mjs",
    "vercel-build": "node scripts/fetch-sdk.mjs && vite build",
    "find:seed": "vite-node scripts/find-demo-seed.ts",
    "postinstall": "node scripts/fetch-sdk.mjs --soft",
    "pretest": "node scripts/require-sdk.mjs",
    "deploy:contract": "node scripts/deploy-contract.mjs",
    "contracts:build": "forge build",
    "verify:survey": "vite-node scripts/verify-survey.ts",
    "verify:brokers": "vite-node scripts/verify-brokers.ts",
    "gen:survey": "vite-node scripts/gen-survey-constants.ts",
    "gen:brokers": "vite-node scripts/gen-brokers-constants.ts"
  },
  "dependencies": {
    "penpal": "^7.0.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.0",
    "viem": "^2.21.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  },
  "homepage": "https://candle-ashen-tau.vercel.app",
  "engines": {
    "node": ">=22"
  }
}
